# Copia este archivo como .env y rellénalo. NUNCA lo subas a GitHub.
DOMAIN=trabajillos.civicloud.es
SITE_URL=https://trabajillos.civicloud.es
ADMIN_EMAIL=tu-correo@ejemplo.com
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio
# Correo saliente (SMTP). Si se deja vacío, los correos solo se escriben en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Trabajillos <no-reply@civicloud.es>
# Datos legales del titular (aparecen en Aviso legal y Privacidad)
LEGAL_NAME=
LEGAL_NIF=
LEGAL_ADDRESS=
LEGAL_EMAIL=
# Opcional: IA para el asistente (si se deja vacío, funciona gratis con reglas)
ANTHROPIC_API_KEY=
